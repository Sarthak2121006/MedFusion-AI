# MedFusion AI Backend Environment Configuration
# Copy this file to .env and update with your settings

# Application
DEBUG=False
API_V1_STR=/api/v1

# Database (PostgreSQL)
# Local development example: postgresql+psycopg://postgres:postgres@localhost:5432/medfusion
# Supabase: postgresql+psycopg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Neon: postgresql+psycopg://[USER]:[PASSWORD]@[HOST]/[DATABASE]
# Railway: postgresql+psycopg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Render: postgresql+psycopg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# AWS RDS: postgresql+psycopg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medfusion
SQLALCHEMY_ECHO=False

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# File Upload
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
REPORTS_DIR=data/reports

# AI Models
MODELS_DIR=models
USE_GPU=False

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@medfusion.ai
