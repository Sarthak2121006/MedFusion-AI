# ===================================================
# MedFusion AI - Environment Configuration Example
# ===================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=MedFusion AI

# JWT Security Configuration (Generate a strong random 64-character secret in production)
JWT_SECRET=replace-with-a-secure-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Persistence & Storage (Paths can be absolute or relative)
DB_PATH=./medfusion.db
UPLOADS_DIR=./uploads

# AI Engine & OCR Execution Paths (Adjust for your hosting environment)
# On Linux/Docker: python3, on Windows: python
PYTHON_PATH=python3
# On Linux/Docker: /usr/bin/tesseract, on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
